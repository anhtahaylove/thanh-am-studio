{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thanh Âm Studio",
  "version": "1.0.2",
  "identifier": "studio.thanham.desktop",
  "build": {"beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist"},
  "app": {
    "windows": [{"create": false, "title": "Thanh Âm Studio", "width": 1440, "height": 960, "minWidth": 1024, "minHeight": 720}],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {"enable": true, "scope": ["$APPLOCALDATA/assets/**"]}
    }
  },
  "bundle": {"active": true, "targets": ["nsis"], "resources": {"../worker/main.py": "worker/main.py", "../worker/diarize.py": "worker/diarize.py", "../worker/models.json": "worker/models.json", "../worker/voices.json": "worker/voices.json", "../runtime/python/": "runtime/python/", "../runtime/ffmpeg/": "runtime/ffmpeg/", "../release/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"}, "windows": {"nsis": {"installMode": "currentUser"}}}
}
